<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="modernwinpos.Views.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:modernwinpos"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:modernwinpos.Models"
    xmlns:vm="using:modernwinpos.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /> <!-- Nav Rail -->
            <ColumnDefinition Width="*" /> <!-- Main Content -->
            <ColumnDefinition Width="320" /> <!-- Transaction Sidebar -->
        </Grid.ColumnDefinitions>

        <!-- Nav Rail -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="0,16">
            <StackPanel Width="64" Spacing="24">
                <SymbolIcon Symbol="Shop" Foreground="{StaticResource PrimaryBrush}" />
                <Button Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Padding="12" CornerRadius="8">
                    <SymbolIcon Symbol="Calculator" Foreground="White" />
                </Button>
                <Button Style="{StaticResource NavButtonStyle}" HorizontalAlignment="Center">
                    <SymbolIcon Symbol="List" />
                </Button>
                <Button Style="{StaticResource NavButtonStyle}" HorizontalAlignment="Center">
                    <SymbolIcon Symbol="Library" />
                </Button>
                <Button Style="{StaticResource NavButtonStyle}" HorizontalAlignment="Center">
                    <SymbolIcon Symbol="Graph" />
                </Button>
                <Button Style="{StaticResource NavButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,200,0,0">
                    <SymbolIcon Symbol="Setting" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Padding="24" RowDefinitions="Auto, Auto, *">
            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBox PlaceholderText="Search items or scan barcode..." Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource SurfaceBrush}" Foreground="White" BorderThickness="0" CornerRadius="8" Padding="36,10,12,10" VerticalAlignment="Center" />
                    <SymbolIcon Symbol="Find" Foreground="#94A3B8" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                </Grid>

                <PersonPicture Grid.Column="1" ProfilePicture="https://lh3.googleusercontent.com/aida-public/AB6AXuAZgrRUvKlvZTMDjpVC5b6e_NAQjCy1lz1hPWnBD4qWSR083xPRvl5w9hIp7hMaBJHBfAybBkvvTrR-ofnjdOn2ufc0Sb8jy3WEoGnGHp9Iyvkh6cBqC7Qik6TxvY8Ygaplgp6eXXfyxVuoIPKBkmlgr-t0Qh2n7BGCW5iVHwMavbbFnINrhdjKp6JQgONj4QeomcFFs_6ayoCSF3m-bccRc_Jnr6H2QwIny3Vrkhi6cQ6_lcaNq8-xsqpPl6onlaChZyaw09KN7Ss" Width="40" Height="40" Margin="16,0,0,0" />
            </Grid>

            <!-- Categories -->
            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" Margin="0,0,0,24">
                <ListView ItemsSource="{x:Bind ViewModel.Categories}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" SelectionMode="Single">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="20" Padding="16,6" Margin="0,0,8,0">
                                <TextBlock Text="{x:Bind}" Foreground="White" />
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>

            <!-- Product Grid -->
            <GridView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Products, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:Product">
                        <Button Command="{Binding ElementName=RootPage, Path=ViewModel.AddToCartCommand}" CommandParameter="{x:Bind}"
                                Padding="0" Margin="0,0,16,16" Width="200" Background="Transparent" BorderThickness="0">
                             <Grid Width="200" Background="{StaticResource SurfaceBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" Source="{x:Bind ImageUrl}" Stretch="UniformToFill" VerticalAlignment="Top" />
                                <Border Background="#80000000" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8" CornerRadius="4" Padding="4,2"
                                        Visibility="{x:Bind IsHotSeller, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="HOT SELLER" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>

                                <StackPanel Grid.Row="1" Padding="12">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="White" />
                                    <TextBlock Text="{x:Bind FormattedPrice}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <!-- Transaction Sidebar -->
        <Grid Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Sidebar Header -->
            <Grid Grid.Row="0" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="Current Sale" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                <Button HorizontalAlignment="Right" Background="Transparent" Foreground="#F87171" Padding="8" CornerRadius="4">
                    <SymbolIcon Symbol="Delete" />
                </Button>
            </Grid>

            <!-- Cart Items -->
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.CartItems, Mode=OneWay}" SelectionMode="None" Padding="16">
                <ListView.ItemContainerStyle>
                     <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                     </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:CartItem">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" Source="{x:Bind Product.ImageUrl}" Width="48" Height="48" Stretch="UniformToFill" />

                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="{x:Bind Product.Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="White" />
                                <TextBlock Text="{x:Bind Product.Category}" FontSize="12" Foreground="#94A3B8" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Background="{StaticResource BackgroundBrush}" CornerRadius="4" Padding="4">
                                    <Button Command="{Binding ElementName=RootPage, Path=ViewModel.DecreaseQuantityCommand}" CommandParameter="{x:Bind}" Background="Transparent" Padding="4" Height="24" Width="24" BorderThickness="0">
                                        <SymbolIcon Symbol="Remove" Width="12" Height="12" Foreground="{StaticResource PrimaryBrush}" />
                                    </Button>
                                    <TextBlock Text="{x:Bind Quantity, Mode=OneWay}" Width="24" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" />
                                    <Button Command="{Binding ElementName=RootPage, Path=ViewModel.IncreaseQuantityCommand}" CommandParameter="{x:Bind}" Background="Transparent" Padding="4" Height="24" Width="24" BorderThickness="0">
                                        <SymbolIcon Symbol="Add" Width="12" Height="12" Foreground="{StaticResource PrimaryBrush}" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{x:Bind FormattedTotalPrice, Mode=OneWay}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0" Foreground="White" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Summary -->
            <StackPanel Grid.Row="2" Padding="24" Background="#10FFFFFF" Spacing="12">
                <Grid>
                    <TextBlock Text="Subtotal" Foreground="#94A3B8" />
                    <TextBlock Text="{x:Bind ViewModel.Subtotal, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#94A3B8" />
                </Grid>
                <Grid>
                    <TextBlock Text="Tax (8%)" Foreground="#94A3B8" />
                    <TextBlock Text="{x:Bind ViewModel.Tax, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#94A3B8" />
                </Grid>
                <Grid Margin="0,8,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <TextBlock Text="Total" FontSize="18" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{x:Bind ViewModel.Total, Mode=OneWay}" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                </Grid>

                <Button Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Height="56">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="PaymentCard" />
                        <TextBlock Text="Pay Now" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
