<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="modernwinpos.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:modernwinpos"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Frame x:Name="ContentFrame" />
    </Grid>

    <!-- Welcome/Navigation Hub Overlay -->
    <Grid x:Name="WelcomeGrid" Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="32">
            <TextBlock Text="Modern POS"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Select a module to begin"
                       FontSize="18"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Opacity="0.8" />
        </StackPanel>

        <StackPanel Grid.Row="1" Padding="48" Spacing="16">
            <Button Command="{x:Bind ViewModel.NavigateToPOSCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Height="64"
                    FontSize="20">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <SymbolIcon Symbol="Shop" Width="32" Height="32" />
                    <TextBlock Text="POS Register" FontWeight="Bold" />
                </StackPanel>
            </Button>

            <Button Command="{x:Bind ViewModel.NavigateToInventoryCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Height="64"
                    FontSize="20">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <SymbolIcon Symbol="AllApps" Width="32" Height="32" />
                    <TextBlock Text="Inventory Management" FontWeight="Bold" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
