<Page
    x:Class="modernwinpos.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:modernwinpos.Converters"
    xmlns:local="using:modernwinpos.Views"
    xmlns:models="using:modernwinpos.Models"
    Background="{StaticResource BackgroundDarkBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToBrushConverter x:Key="StatusBackgroundConverter"
                                         TrueBrush="{StaticResource AlertRedBrush}"
                                         FalseBrush="{StaticResource SuccessGreenBrush}" />
        <converters:BoolToBrushConverter x:Key="StatusForegroundConverter"
                                         TrueBrush="{StaticResource AlertRedBrush}"
                                         FalseBrush="{StaticResource SuccessGreenBrush}" />
        <converters:BoolToBrushConverter x:Key="StatusBorderConverter"
                                         TrueBrush="{StaticResource AlertRedBrush}"
                                         FalseBrush="Transparent" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Search -->
            <RowDefinition Height="*" />    <!-- List -->
            <RowDefinition Height="Auto" /> <!-- Bottom Nav -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,12" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Inventory" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.TotalProducts}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource Action}" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" Padding="8">
                    <SymbolIcon Symbol="Download" />
                </Button>
                <Button Style="{StaticResource PrimaryAction}" Padding="8">
                    <SymbolIcon Symbol="Add" Foreground="White" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search and Filters -->
        <StackPanel Grid.Row="1" Padding="16,16,16,8" Spacing="16">
            <!-- Search Box -->
            <Grid>
                <TextBox PlaceholderText="Search products, ID, or category..."
                         BorderThickness="1"
                         BorderBrush="#1FFFFFFF"
                         Background="#0DFFFFFF"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         CornerRadius="8"
                         Padding="12,10,40,10">
                </TextBox>
                <SymbolIcon Symbol="Find" HorizontalAlignment="Right" Margin="0,0,12,0" Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False"/>
            </Grid>

            <!-- Filters -->
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="All Items" Background="{StaticResource PrimaryBrush}" Foreground="White" CornerRadius="16" Padding="12,6" FontSize="12" FontWeight="Medium" BorderThickness="0"/>
                    <Button Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AlertRedBrush}" />
                            <TextBlock Text="Low Stock" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Content="Electronics" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Foreground="{StaticResource TextSecondaryBrush}" CornerRadius="16" Padding="12,6" FontSize="12" />
                    <Button Content="Accessories" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Foreground="{StaticResource TextSecondaryBrush}" CornerRadius="16" Padding="12,6" FontSize="12" />
                    <Button Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="8,6">
                        <SymbolIcon Symbol="Setting" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <!-- Product List -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Products}" Padding="16,0,16,80" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,0,0,12" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <Grid Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="#1FFFFFFF">
                        <!-- Low Stock Indicator Bar -->
                        <Border Width="4" HorizontalAlignment="Left" Background="{x:Bind IsLowStock, Converter={StaticResource StatusBackgroundConverter}}" Opacity="0.8" CornerRadius="2,0,0,2" Visibility="{x:Bind IsLowStock, Converter={StaticResource BoolToVis}}" />

                        <Grid Padding="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Row -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Width="40" Height="40" Background="#0DFFFFFF" CornerRadius="8" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                    <SymbolIcon Symbol="{x:Bind SymbolIcon}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>

                                <!-- Name/SKU -->
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="Medium" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Sku}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Price/Badge -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind PriceFormatted}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                    <Grid Margin="0,4,0,0" HorizontalAlignment="Right">
                                        <Border CornerRadius="4" Background="{x:Bind IsLowStock, Converter={StaticResource StatusBackgroundConverter}}" Opacity="0.2" />
                                        <TextBlock Text="{x:Bind StatusText}" FontSize="10" FontWeight="Bold" Foreground="{x:Bind IsLowStock, Converter={StaticResource StatusForegroundConverter}}" Padding="6,2" HorizontalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Divider -->
                            <Rectangle Grid.Row="1" Height="1" Fill="#0DFFFFFF" Margin="0,12" />

                            <!-- Bottom Row -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="STOCK LEVEL" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7" />
                                    <TextBlock Text="{x:Bind StockLevelText}" FontSize="14" FontWeight="SemiBold" Foreground="{x:Bind IsLowStock, Converter={StaticResource StatusForegroundConverter}}" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="CATEGORY" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7" />
                                    <TextBlock Text="{x:Bind Category}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <Button Grid.Column="2" Background="Transparent" Padding="6" CornerRadius="8">
                                    <SymbolIcon Symbol="More" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Bottom Navigation -->
        <Grid Grid.Row="3" Background="#cc101922" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="0,8,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <SymbolIcon Symbol="AllApps" Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Text="Inventory" FontSize="10" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" FontWeight="Medium" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4" Opacity="0.6">
                <SymbolIcon Symbol="Shop" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="Register" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" FontWeight="Medium" />
            </StackPanel>

            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="4" Opacity="0.6">
                <SymbolIcon Symbol="Memo" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="Reports" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" FontWeight="Medium" />
            </StackPanel>

            <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="4" Opacity="0.6">
                <SymbolIcon Symbol="Setting" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="Settings" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" FontWeight="Medium" />
            </StackPanel>
        </Grid>

        <!-- Floating Alert -->
        <Border Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
                Background="#26ef4444" BorderBrush="#40ef4444" BorderThickness="1" CornerRadius="12" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8" Fill="{StaticResource AlertRedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="2 items need restock" FontSize="12" FontWeight="Medium" Foreground="#FECACA" VerticalAlignment="Center" />
                <Button Content="VIEW" Foreground="{StaticResource PrimaryBrush}" Background="Transparent" FontSize="10" FontWeight="Bold" Padding="4,0" BorderThickness="0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

    </Grid>
</Page>
